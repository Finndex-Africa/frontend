# NEXT_PUBLIC_API_URL=https://api.findafriq.com/api #production api
# NEXT_PUBLIC_SITE_URL=https://findafriq.com # canonical site origin (Open Graph / social previews)
# NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.findafriq.com #production admin dashboard
NEXT_PUBLIC_DASHBOARD_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_STREAM_KEY=
NEXT_PUBLIC_APP_ENV=
NODE_ENV=
STREAM_KEY=
STREAM_SECRET=
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# --- FindAfriq Assistant (chatbot) ---
# Server-side only. Never prefix with NEXT_PUBLIC_ — that would ship the key to browsers.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.6-terra. Set to gpt-5.6-sol for the strongest
# answers, or gpt-5.6-luna for the lowest cost per message.
OPENAI_MODEL=
